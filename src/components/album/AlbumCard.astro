---
import { imageUrl } from "../../lib/images";

interface Props {
  slug: string;
  title: string;
  date: Date;
  cover: string;
  location?: string;
  tags?: string[];
}

const { slug, title, date, cover, location, tags = [] } = Astro.props;

const formattedDate = date.toLocaleDateString("en-US", {
  month: "long",
  year: "numeric",
});

const coverUrl = imageUrl(slug, cover, 800, "jpeg");
---

<a href={`/albums/${slug}`} class="album-card">
  <div class="album-card-image">
    <img
      src={coverUrl}
      alt={title}
      loading="lazy"
      decoding="async"
    />
  </div>
  <div class="album-card-info">
    <h3 class="album-card-title">{title}</h3>
    <div class="album-card-meta">
      <time>{formattedDate}</time>
      {location && <span class="album-card-location">{location}</span>}
    </div>
  </div>
</a>

<style>
  .album-card {
    display: block;
    text-decoration: none;
    color: inherit;
    transition: transform 0.2s ease;
  }

  .album-card:hover {
    transform: translateY(-2px);
  }

  .album-card-image {
    aspect-ratio: 3 / 2;
    overflow: hidden;
    margin-bottom: 0.75rem;
  }

  .album-card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: opacity 0.2s ease;
  }

  .album-card:hover .album-card-image img {
    opacity: 0.9;
  }

  .album-card-title {
    font-family: var(--font-serif);
    font-size: 1.1rem;
    font-weight: 500;
    margin-bottom: 0.25rem;
    line-height: 1.3;
  }

  .album-card-meta {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-text-muted);
    display: flex;
    gap: 0.75rem;
  }

  .album-card-location::before {
    content: "·";
    margin-right: 0.75rem;
  }
</style>
